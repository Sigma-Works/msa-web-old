rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Event images: anyone can read, only authenticated users can write
    match /EventsImages/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
