rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // RSVP links: anyone can read, only authenticated users can write
    match /RSVP/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Event images: anyone can read, only authenticated users can write
    match /EventsImages/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
